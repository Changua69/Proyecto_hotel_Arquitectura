# Copiar como .env y ajustar. Valores de ejemplo, NO son credenciales reales.
# MongoDB debe estar en modo replica set (rs0) para admitir transacciones.
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# Base de la capa de persistencia (semana 13). Distinta de hotel_db: reset_db la borra y recrea.
MONGO_DB_PRUEBA=marea_test
DATABASE_NAME=hotel_db
SECRET_KEY=cambiar_esta_clave
